# Copy to .env and fill in. .env is gitignored.

# Google Places API — discovery only (stays within the free $200/mo credit)
GOOGLE_PLACES_API_KEY=your_key_here

# Local AI (Ollama) — does all enrichment + content generation, no API cost.
# Defaults work out of the box if Ollama runs locally; override if needed.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=180

# Translation (translate.py). Default provider is OpenRouter on a FREE model
# (costs $0; the one-time $10 top-up only unlocks 1000 free requests/day).
TRANSLATE_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your_key_here
# Must end in ':free'. Verify it's still listed at openrouter.ai/models.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
