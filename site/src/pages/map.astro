---
import { loadRestaurants, getUniqueTowns, getUniqueCuisines } from '../lib/restaurants.js';

const restaurants = loadRestaurants();
const towns = getUniqueTowns(restaurants);
const cuisines = getUniqueCuisines(restaurants);

const mapData = restaurants
  .filter(r => r.coordinates?.lat && r.coordinates?.lng)
  .map(r => ({
    slug:    r.slug,
    name:    r.name,
    town:    r.town,
    lat:     r.coordinates.lat,
    lng:     r.coordinates.lng,
    rating:  r.google_rating || 0,
    reviews: r.google_review_count || 0,
    price:   r.price_level || 2,
    cuisine: (r.cuisine_types || []).slice(0, 2),
    short:   r.description_short || '',
    photo:   r.photos?.[0]?.url || '',
  }));

const townOptions  = towns.map(t => `<option value="${t}">${t}</option>`).join('');
const cuisineOptions = cuisines.map(c => `<option value="${c}">${c}</option>`).join('');
const dataJson = JSON.stringify(mapData).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en-ZA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Restaurant Map — Garden Route</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <!-- MarkerCluster -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: #f9f8f6; color: #111; }

    /* ── Layout ── */
    .app { display: flex; flex-direction: column; height: 100vh; }

    /* ── Topbar ── */
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px; height: 52px; background: #fff;
      border-bottom: 1px solid #e5e7eb; flex-shrink: 0; z-index: 100;
    }
    .logo { font-weight: 700; font-size: 16px; color: #0d7ec4; text-decoration: none; display: flex; align-items: center; gap: 6px; }
    .topnav { display: flex; align-items: center; gap: 20px; font-size: 13px; font-weight: 500; }
    .topnav a { color: #374151; text-decoration: none; }
    .topnav a:hover { color: #0d7ec4; }
    .topnav .btn { background: #0d7ec4; color: #fff; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .topnav .btn:hover { background: #0b6ca8; }
    .map-link { color: #0d7ec4 !important; font-weight: 600; }

    /* ── Body: sidebar + map ── */
    .body { display: flex; flex: 1; overflow: hidden; }

    /* ── Sidebar ── */
    .sidebar {
      width: 300px; flex-shrink: 0; display: flex; flex-direction: column;
      background: #fff; border-right: 1px solid #e5e7eb; overflow: hidden;
    }
    .filters { padding: 14px; border-bottom: 1px solid #f3f4f6; display: flex; flex-direction: column; gap: 8px; }
    .filters h2 { font-size: 13px; font-weight: 700; color: #111; }
    .filters input, .filters select {
      width: 100%; padding: 8px 10px; font-size: 13px; font-family: inherit;
      border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; color: #111;
      outline: none; appearance: auto;
    }
    .filters input:focus, .filters select:focus { border-color: #0d7ec4; box-shadow: 0 0 0 2px #dbeafe; }
    .rating-row { display: flex; flex-direction: column; gap: 4px; }
    .rating-row label { font-size: 11px; color: #6b7280; font-weight: 500; }
    .filters input[type=range] { padding: 0; height: 4px; accent-color: #0d7ec4; cursor: pointer; }
    .reset-btn {
      width: 100%; padding: 8px; font-size: 12px; font-weight: 600; font-family: inherit;
      color: #6b7280; background: #f9fafb; border: 1px solid #e5e7eb;
      border-radius: 8px; cursor: pointer;
    }
    .reset-btn:hover { background: #f3f4f6; }
    .count { padding: 8px 14px; font-size: 11px; color: #9ca3af; font-weight: 500; border-bottom: 1px solid #f3f4f6; flex-shrink: 0; }

    /* ── List ── */
    #list { flex: 1; overflow-y: auto; }
    .list-item {
      padding: 10px 14px; border-bottom: 1px solid #f3f4f6;
      cursor: pointer; transition: background 0.1s;
    }
    .list-item:hover { background: #f0f9ff; }
    .list-item.active { background: #dbeafe; }
    .li-name { font-size: 13px; font-weight: 600; color: #111; line-height: 1.3; }
    .li-meta { font-size: 11px; color: #6b7280; margin-top: 2px; }
    .li-rating { font-size: 11px; color: #f59e0b; font-weight: 600; margin-top: 2px; }
    .empty { padding: 32px 16px; text-align: center; color: #9ca3af; font-size: 13px; }

    /* ── Map ── */
    #map { flex: 1; z-index: 0; }

    /* ── Popup ── */
    .leaflet-popup-content-wrapper {
      border-radius: 12px !important; padding: 0 !important;
      overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.18) !important;
    }
    .leaflet-popup-content { margin: 0 !important; width: 250px !important; }
    .popup-img { width: 100%; height: 120px; object-fit: cover; display: block; background: #f3f4f6; }
    .popup-no-img { width: 100%; height: 80px; background: #f3f4f6; display: flex; align-items: center; justify-content: center; font-size: 28px; }
    .popup-body { padding: 12px 14px 14px; }
    .popup-name { font-weight: 700; font-size: 14px; color: #111; line-height: 1.3; margin-bottom: 3px; }
    .popup-meta { font-size: 11px; color: #6b7280; margin-bottom: 5px; }
    .popup-rating { font-size: 12px; color: #f59e0b; font-weight: 600; margin-bottom: 7px; }
    .popup-short { font-size: 11px; color: #374151; line-height: 1.5; margin-bottom: 10px; }
    .popup-link {
      display: block; text-align: center; background: #0d7ec4; color: #fff;
      font-size: 12px; font-weight: 600; padding: 8px; border-radius: 8px; text-decoration: none;
    }
    .popup-link:hover { background: #0b6ca8; color: #fff; }

    /* ── Cluster colours ── */
    .marker-cluster-small { background-color: rgba(13,126,196,0.2) !important; }
    .marker-cluster-small div { background-color: rgba(13,126,196,0.85) !important; color: #fff !important; font-weight: 700; }
    .marker-cluster-medium { background-color: rgba(13,126,196,0.2) !important; }
    .marker-cluster-medium div { background-color: rgba(13,126,196,0.85) !important; color: #fff !important; font-weight: 700; }
    .marker-cluster-large { background-color: rgba(13,126,196,0.2) !important; }
    .marker-cluster-large div { background-color: rgba(13,126,196,0.85) !important; color: #fff !important; font-weight: 700; }
  </style>
</head>
<body>
<div class="app">

  <!-- Topbar -->
  <header class="topbar">
    <a href="/" class="logo">🌊 gardenroute</a>
    <nav class="topnav">
      <a href="/browse">Browse</a>
      <a href="/map" class="map-link">Map</a>
      <a href="/towns">Towns</a>
      <a href="/about">About</a>
      <a href="/submit" class="btn">Add restaurant</a>
    </nav>
  </header>

  <!-- Body -->
  <div class="body">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="filters">
        <h2>Filter restaurants</h2>
        <input id="search" type="text" placeholder="Search by name…" />
        <select id="f-town"><option value="">All towns</option>{Fragment.set:html(townOptions)}</select>
        <select id="f-cuisine"><option value="">All cuisines</option>{Fragment.set:html(cuisineOptions)}</select>
        <select id="f-price">
          <option value="">Any price</option>
          <option value="1">R — Budget</option>
          <option value="2">RR — Mid-range</option>
          <option value="3">RRR — Upmarket</option>
          <option value="4">RRRR — Fine dining</option>
        </select>
        <div class="rating-row">
          <label>Min rating: <strong id="rating-val">Any</strong></label>
          <input type="range" id="f-rating" min="0" max="5" step="0.5" value="0" />
        </div>
        <button class="reset-btn" id="reset">Reset filters</button>
      </div>
      <div class="count"><span id="count">0</span> restaurants shown</div>
      <div id="list"></div>
    </aside>

    <!-- Map -->
    <div id="map"></div>
  </div>
</div>

<script define:vars={{ mapData, townOptions, cuisineOptions }}>
  // Inject town/cuisine options
  document.getElementById('f-town').innerHTML   = '<option value="">All towns</option>'   + townOptions;
  document.getElementById('f-cuisine').innerHTML = '<option value="">All cuisines</option>' + cuisineOptions;

  const PRICE = ['','R','RR','RRR','RRRR'];

  function stars(r) {
    const f = Math.floor(r), h = (r % 1) >= 0.5 ? 1 : 0;
    return '★'.repeat(f) + (h ? '½' : '') + '☆'.repeat(5 - f - h);
  }

  // ── Map ──────────────────────────────────────────────────────────────────
  const map = L.map('map', { zoomControl: false }).setView([-33.97, 22.85], 9);
  L.control.zoom({ position: 'bottomright' }).addTo(map);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19,
  }).addTo(map);

  const cluster = L.markerClusterGroup({
    showCoverageOnHover: false,
    maxClusterRadius: 50,
    spiderfyOnMaxZoom: true,
  });
  map.addLayer(cluster);

  function pinIcon(rating) {
    const color = rating >= 4.3 ? '#059669' : rating >= 3.5 ? '#0d7ec4' : '#9ca3af';
    return L.divIcon({
      className: '',
      html: `<svg width="28" height="36" viewBox="0 0 28 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M14 0C6.27 0 0 6.27 0 14c0 9.75 14 22 14 22s14-12.25 14-22C28 6.27 21.73 0 14 0z" fill="${color}" stroke="#fff" stroke-width="2"/>
        <circle cx="14" cy="14" r="5" fill="#fff"/>
      </svg>`,
      iconSize: [28, 36],
      iconAnchor: [14, 36],
      popupAnchor: [0, -38],
    });
  }

  function popupHtml(r) {
    const img = r.photo
      ? `<img class="popup-img" src="${r.photo}" alt="${r.name}" loading="lazy" />`
      : `<div class="popup-no-img">🍽</div>`;
    return `${img}
      <div class="popup-body">
        <div class="popup-name">${r.name}</div>
        <div class="popup-meta">${r.cuisine.join(', ') || ''} · ${r.town} · ${PRICE[r.price] || 'RR'}</div>
        ${r.rating ? `<div class="popup-rating">${stars(r.rating)} ${r.rating} <span style="color:#9ca3af;font-weight:400">(${r.reviews})</span></div>` : ''}
        ${r.short ? `<div class="popup-short">${r.short}</div>` : ''}
        <a class="popup-link" href="/${r.slug}">View restaurant →</a>
      </div>`;
  }

  // Build all markers
  const markerMap = {};
  mapData.forEach(r => {
    const m = L.marker([r.lat, r.lng], { icon: pinIcon(r.rating) });
    m.bindPopup(popupHtml(r), { maxWidth: 250, minWidth: 250 });
    m._r = r;
    markerMap[r.slug] = m;
    cluster.addLayer(m);
  });

  // ── List ─────────────────────────────────────────────────────────────────
  const listEl   = document.getElementById('list');
  const countEl  = document.getElementById('count');
  let activeSlug = null;

  function renderList(items) {
    countEl.textContent = items.length;
    if (!items.length) {
      listEl.innerHTML = '<div class="empty">No restaurants match your filters.</div>';
      return;
    }
    listEl.innerHTML = items.map(r => `
      <div class="list-item${r.slug === activeSlug ? ' active' : ''}" data-slug="${r.slug}">
        <div class="li-name">${r.name}</div>
        <div class="li-meta">${r.town}${r.cuisine[0] ? ' · ' + r.cuisine[0] : ''} · ${PRICE[r.price] || 'RR'}</div>
        ${r.rating ? `<div class="li-rating">${stars(r.rating)} ${r.rating}</div>` : ''}
      </div>`).join('');

    listEl.querySelectorAll('.list-item').forEach(el => {
      el.addEventListener('click', () => flyTo(el.dataset.slug));
    });
  }

  function flyTo(slug) {
    const r = mapData.find(x => x.slug === slug);
    if (!r) return;
    activeSlug = slug;
    map.flyTo([r.lat, r.lng], 15, { duration: 0.7 });
    setTimeout(() => {
      const m = markerMap[slug];
      if (m) cluster.zoomToShowLayer(m, () => m.openPopup());
    }, 750);
    listEl.querySelectorAll('.list-item').forEach(el =>
      el.classList.toggle('active', el.dataset.slug === slug));
    const active = listEl.querySelector('.list-item.active');
    if (active) active.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Sync popup → list highlight
  map.on('popupopen', e => {
    const m = e.popup._source;
    if (m && m._r) {
      activeSlug = m._r.slug;
      listEl.querySelectorAll('.list-item').forEach(el =>
        el.classList.toggle('active', el.dataset.slug === activeSlug));
      const active = listEl.querySelector('.list-item.active');
      if (active) active.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  // ── Filters ───────────────────────────────────────────────────────────────
  const searchEl  = document.getElementById('search');
  const townEl    = document.getElementById('f-town');
  const cuisineEl = document.getElementById('f-cuisine');
  const priceEl   = document.getElementById('f-price');
  const ratingEl  = document.getElementById('f-rating');
  const ratingVal = document.getElementById('rating-val');

  function applyFilters() {
    const q      = searchEl.value.trim().toLowerCase();
    const town   = townEl.value;
    const cuis   = cuisineEl.value;
    const price  = parseInt(priceEl.value) || 0;
    const minRat = parseFloat(ratingEl.value) || 0;
    ratingVal.textContent = minRat > 0 ? `${minRat}+` : 'Any';

    const filtered = mapData.filter(r => {
      if (q && !r.name.toLowerCase().includes(q)) return false;
      if (town && r.town !== town) return false;
      if (cuis && !r.cuisine.includes(cuis)) return false;
      if (price && r.price !== price) return false;
      if (minRat && r.rating < minRat) return false;
      return true;
    });

    cluster.clearLayers();
    filtered.forEach(r => { if (markerMap[r.slug]) cluster.addLayer(markerMap[r.slug]); });
    renderList(filtered);
  }

  searchEl.addEventListener('input', applyFilters);
  townEl.addEventListener('change', applyFilters);
  cuisineEl.addEventListener('change', applyFilters);
  priceEl.addEventListener('change', applyFilters);
  ratingEl.addEventListener('input', applyFilters);

  document.getElementById('reset').addEventListener('click', () => {
    searchEl.value = townEl.value = cuisineEl.value = priceEl.value = '';
    ratingEl.value = 0;
    applyFilters();
  });

  // Initial render
  applyFilters();
</script>
</body>
</html>
