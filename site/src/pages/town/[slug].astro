---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import RestaurantCard from '../../components/RestaurantCard.astro';
import {
  loadRestaurants, getUniqueTowns, restaurantsInTown, townSlug,
  topCuisines, avgRating, priceLong, priceLabel, townImage, loadTownContent,
  toSlug, openInTownOn, rankByRating,
} from '../../lib/restaurants.js';
import { CATEGORIES, TOWN_MIN_COUNT, OPEN_DAYS, OPEN_MIN_COUNT } from '../../lib/categories.js';
import { LOCALES, DEFAULT_LOCALE } from '../../i18n/utils.js';

export async function getStaticPaths() {
  const restaurants = loadRestaurants();
  const towns = getUniqueTowns(restaurants);
  return towns.map(town => ({
    params: { slug: townSlug(town) },
    props: { town, restaurants: restaurantsInTown(restaurants, town) },
  }));
}

const { town, restaurants } = Astro.props;
const siteUrl = 'https://www.gardenroute-restaurants.co.za';

// Sort: featured first, then by rating
const list = [...restaurants].sort((a, b) =>
  (b.featured === a.featured ? (b.google_rating || 0) - (a.google_rating || 0) : (b.featured ? 1 : -1))
);

const count    = list.length;
const cuisines = topCuisines(list, 4);
const rating   = avgRating(list);
// Top 10 by review-weighted rating (shown above the full grid once a town has enough places)
const ranked   = rankByRating(list);
const top10    = count >= 8 ? ranked.slice(0, 10) : [];
const names    = (rs) => rs.map(r => r.name).join(', ').replace(/, ([^,]*)$/, ' and $1');
const hasAny   = (r, labels) => labels.some(l => (r.cuisine_types || []).includes(l) || (r.tags || []).includes(l));
const sunday   = rankByRating(openInTownOn(restaurants, town, 'sunday'));
const breakfast = ranked.filter(r => hasAny(r, ['Breakfast & Brunch', 'Breakfast']));
const seaView  = ranked.filter(r => hasAny(r, ['Ocean views', 'Waterfront']));
const family   = ranked.filter(r => hasAny(r, ['Family friendly', 'Family-friendly']));
const hero     = `${siteUrl}/images/towns/${townSlug(town)}.jpg`;  // absolute for og:image

// Optional richer copy from local-AI generator; else build a unique data-driven intro.
const content  = loadTownContent();
const aiCopy   = content[town] || content[townSlug(town)] || null;

const introFallback = `${town} is home to ${count} ${count === 1 ? 'restaurant' : 'restaurants'} on South Africa's Garden Route, with an average rating of ${rating}★ from real Google reviews. ` +
  (cuisines.length ? `You'll find everything from ${cuisines.slice(0, -1).join(', ')}${cuisines.length > 1 ? ' and ' : ''}${cuisines[cuisines.length - 1]} here — ` : '') +
  `whether you're after a relaxed breakfast, a sea-view lunch or a special dinner out. Every listing below has up-to-date ratings, opening hours and contact details.`;

const intro = aiCopy?.intro || introFallback;

// FAQ — use AI copy if available, else generate sensible defaults
const topPick = ranked[0];
const faqs = aiCopy?.faqs || [
  {
    q: `How many restaurants are there in ${town}?`,
    a: `Our directory lists ${count} ${count === 1 ? 'restaurant' : 'restaurants'} in ${town}, on the Garden Route, each with current ratings, opening hours and contact details.`,
  },
  topPick && {
    q: `What is the best-rated restaurant in ${town}?`,
    a: `${topPick.name} is among the highest-rated in ${town}, with ${topPick.google_rating}★ from ${topPick.google_review_count} Google reviews. ${topPick.description_short || ''}`.trim(),
  },
  cuisines.length && {
    q: `What kind of food can I find in ${town}?`,
    a: `Popular options in ${town} include ${cuisines.join(', ')}. Use the filters on our browse page to narrow by cuisine, price or features like sea views and dog-friendly.`,
  },
  sunday.length >= 3 && {
    q: `Which restaurants in ${town} are open on Sunday?`,
    a: `${sunday.length} of the ${count} restaurants we list in ${town} are open on Sundays, including ${names(sunday.slice(0, 3))}. Hours can change on public holidays, so call ahead.`,
  },
  breakfast.length >= 2 && {
    q: `Where can I get breakfast in ${town}?`,
    a: `${breakfast.length} places in ${town} serve breakfast or brunch. The best rated are ${names(breakfast.slice(0, 3))}.`,
  },
  seaView.length >= 2 && {
    q: `Which ${town} restaurants have a sea or water view?`,
    a: `${names(seaView.slice(0, 3))} are the best-rated ${town} restaurants with ocean or waterfront views.`,
  },
  family.length >= 2 && {
    q: `Which restaurants in ${town} are good for families?`,
    a: `${names(family.slice(0, 3))} are the best-rated family-friendly restaurants in ${town}.`,
  },
].filter(Boolean);

const seoTitle = `Best Restaurants in ${town} (${count}) — Garden Route, South Africa`;
// Name the top places in the search snippet — as many (3, 2 or 1) as fit in ~160 characters.
const descWith = (n) => `${count} places to eat in ${town}, Garden Route — including ${names(ranked.slice(0, n))}. Ratings, opening hours, menus and directions.`;
const seoDesc  = (count >= 5 ? [3, 2, 1] : []).map(descWith).find(d => d.length <= 160)
  || `Discover the best places to eat in ${town} on the Garden Route. Browse ${count} ${count === 1 ? 'restaurant' : 'restaurants'} with ratings, opening hours, menus and directions.`;

// Schema: ItemList of restaurants + FAQPage + Breadcrumbs
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Restaurants in ${town}, Garden Route`,
  "numberOfItems": count,
  "itemListElement": list.slice(0, 30).map((r, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${siteUrl}/${r.slug}/`,
    "name": r.name,
  })),
};

const faqSchema = faqs.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Towns", "item": `${siteUrl}/towns/` },
    { "@type": "ListItem", "position": 3, "name": town, "item": `${siteUrl}/town/${townSlug(town)}/` },
  ],
};

// Other towns for internal linking
const allTowns = getUniqueTowns(loadRestaurants()).filter(t => t !== town);

// hreflang alternates — localized town pages exist for every locale
const alternates = LOCALES.map(l => ({
  lang: l,
  path: l === DEFAULT_LOCALE ? `/town/${townSlug(town)}/` : `/${l}/town/${townSlug(town)}/`,
}));

// Town-scoped category & open-on-day sub-pages that exist for this town
const inCategory = (r, c) => (r.cuisine_types || []).includes(c.label) || (r.tags || []).includes(c.label);
const subPages = [
  ...CATEGORIES
    .map(c => ({ label: (c.h1 || c.label).replace(/^\w/, ch => ch.toUpperCase()), s: c.slug || toSlug(c.label), n: restaurants.filter(r => inCategory(r, c)).length, min: TOWN_MIN_COUNT })),
  ...OPEN_DAYS
    .map(d => ({ label: `Open on ${d.charAt(0).toUpperCase() + d.slice(1)}`, s: `open-on-${d}`, n: openInTownOn(restaurants, town, d).length, min: OPEN_MIN_COUNT })),
].filter(p => p.n >= p.min);
---

<Base title={seoTitle} description={seoDesc} image={hero} schema={itemListSchema} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <Nav langLinks={alternates} />

  <div class="max-w-7xl mx-auto px-6 py-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm text-gray-400 list-none p-0 m-0">
        <li><a href="/" class="hover:text-gray-600 no-underline">Home</a></li>
        <li>›</li>
        <li><a href="/towns/" class="hover:text-gray-600 no-underline">Towns</a></li>
        <li>›</li>
        <li class="text-gray-600 font-medium">{town}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-8">
      <p class="text-xs font-semibold tracking-widest uppercase text-ocean-600 mb-2">Garden Route · South Africa</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Best restaurants in {town}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-5">
        <span><strong class="text-gray-900">{count}</strong> restaurants</span>
        {rating > 0 && <span class="stars">★ <span class="text-gray-900 font-semibold">{rating}</span> avg</span>}
        {cuisines.length > 0 && <span>{cuisines.slice(0,3).join(' · ')}</span>}
      </div>
      <p class="text-gray-700 leading-relaxed max-w-3xl">{intro}</p>
    </header>

    <!-- Town-scoped category pages — programmatic long-tail landing pages -->
    {subPages.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-10" aria-label={`Browse ${town} restaurants by category`}>
        {subPages.map(p => (
          <a href={`/town/${townSlug(town)}/${p.s}/`}
             class="px-3 py-1.5 rounded-full bg-sand text-sm text-gray-600 hover:text-ocean-600 no-underline transition-colors">
            {p.label} <span class="text-gray-400">({p.n})</span>
          </a>
        ))}
      </div>
    )}

    <!-- Top 10 — a quick answer before the full grid -->
    {top10.length > 0 && (
      <section class="mb-12 max-w-3xl">
        <h2 class="font-display text-2xl font-bold mb-2">Top {top10.length} restaurants in {town}</h2>
        <p class="text-sm text-gray-500 mb-5">Ranked by Google rating, weighted by how many diners have reviewed each place.</p>
        <ol class="list-none p-0 m-0 space-y-3">
          {top10.map((r, i) => (
            <li class="flex gap-4 bg-white rounded-xl border border-gray-100 p-4">
              <span class="font-display text-2xl font-bold text-ocean-600 w-8 shrink-0">{i + 1}</span>
              <div class="min-w-0">
                <h3 class="font-semibold text-base m-0">
                  <a href={`/${r.slug}/`} class="text-gray-900 hover:text-ocean-600 no-underline">{r.name}</a>
                </h3>
                <p class="text-sm text-gray-500 mt-0.5 mb-1">
                  <span class="stars">★</span> <span class="font-medium text-gray-900">{r.google_rating}</span> ({r.google_review_count} reviews)
                  {' · '}{(r.cuisine_types || [])[0] || 'Restaurant'}{' · '}{priceLabel(r.price_level)}
                </p>
                {r.description_short && <p class="text-sm text-gray-600 m-0">{r.description_short}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Restaurant grid -->
    <h2 class="font-display text-2xl font-bold mb-5">All {count} restaurants in {town}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {list.map(r => <RestaurantCard restaurant={r} featured={r.featured} />)}
    </div>

    <!-- FAQ -->
    {faqs.length > 0 && (
      <section class="max-w-3xl mb-12">
        <h2 class="font-display text-2xl font-bold mb-5">Frequently asked questions</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <details class="bg-white rounded-xl border border-gray-100 p-5">
              <summary class="font-semibold cursor-pointer">{f.q}</summary>
              <p class="text-gray-700 leading-relaxed mt-3">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Internal links to other towns -->
    <section class="pt-8 border-t border-gray-100">
      <h2 class="font-semibold text-base mb-3 text-gray-500">Explore more Garden Route towns</h2>
      <div class="flex flex-wrap gap-2">
        {allTowns.map(t => (
          <a href={`/town/${townSlug(t)}/`}
             class="px-3 py-1.5 rounded-full border border-gray-200 text-sm text-gray-600 hover:border-ocean-400 hover:text-ocean-600 no-underline transition-colors">
            {t}
          </a>
        ))}
      </div>
    </section>
  </div>

  <footer class="border-t border-gray-100 py-8 px-6 mt-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <p>© 2026 gardenroute-restaurants.co.za · Curated by humans</p>
      <div class="flex items-center gap-4">
        <a href="/browse/" class="hover:text-gray-600 no-underline">Browse all</a>
        <a href="/towns/" class="hover:text-gray-600 no-underline">Towns</a>
        <a href="/about/" class="hover:text-gray-600 no-underline">About</a>
      </div>
    </div>
  </footer>
</Base>
