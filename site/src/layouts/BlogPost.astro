---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';

const { frontmatter } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  image = 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1200&q=80',
  category = 'Guide',
} = frontmatter;

const siteUrl = 'https://www.gardenroute-restaurants.co.za';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const published = new Date(pubDate);
const modified = updatedDate ? new Date(updatedDate) : published;
const niceDate = published.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image,
  "datePublished": published.toISOString(),
  "dateModified": modified.toISOString(),
  "author": { "@type": "Organization", "name": "Garden Route Restaurants", "url": siteUrl },
  "publisher": {
    "@type": "Organization",
    "name": "Garden Route Restaurants",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "isPartOf": { "@type": "Blog", "name": "Garden Route Dining Guides", "url": `${siteUrl}/blog` }
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": `${siteUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonical },
  ]
};
---

<Base title={`${title} | Garden Route Restaurants`} description={description} image={image} type="article" schema={schema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <Nav />

  <article class="max-w-3xl mx-auto px-6 py-10">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm text-gray-400 list-none p-0 m-0">
        <li><a href="/" class="hover:text-gray-600 no-underline">Home</a></li>
        <li>›</li>
        <li><a href="/blog" class="hover:text-gray-600 no-underline">Guides</a></li>
        <li>›</li>
        <li class="text-gray-600 font-medium truncate">{category}</li>
      </ol>
    </nav>

    <p class="text-xs font-semibold tracking-widest uppercase text-ocean-600 mb-3">{category} · Garden Route</p>
    <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight mb-4">{title}</h1>
    <p class="text-gray-500 mb-8 text-sm">Updated {niceDate}</p>

    <div class="article-body">
      <slot />
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-2xl bg-sand p-6 text-center">
      <p class="font-display text-xl font-bold mb-2">Find your next favourite table</p>
      <p class="text-gray-600 mb-4 text-sm">Browse 400+ Garden Route restaurants with ratings, hours and directions.</p>
      <a href="/browse" class="inline-block px-6 py-3 bg-ocean-600 hover:bg-ocean-700 text-white font-semibold rounded-full text-sm no-underline transition-colors">Browse all restaurants →</a>
    </div>

    <p class="mt-8 text-sm text-gray-400">
      More guides: <a href="/blog" class="text-ocean-600 hover:underline">all Garden Route dining guides →</a>
    </p>
  </article>

  <footer class="border-t border-gray-100 py-8 px-6 mt-8">
    <div class="max-w-3xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <p>© 2026 gardenroute-restaurants.co.za</p>
      <div class="flex items-center gap-4">
        <a href="/blog" class="hover:text-gray-600 no-underline">Guides</a>
        <a href="/browse" class="hover:text-gray-600 no-underline">Browse</a>
        <a href="/towns" class="hover:text-gray-600 no-underline">Towns</a>
      </div>
    </div>
  </footer>
</Base>

<style is:global>
  .article-body { color: #374151; font-size: 1.075rem; line-height: 1.75; }
  .article-body > p { margin: 0 0 1.25rem; }
  .article-body h2 { font-family: 'Fraunces', Georgia, serif; font-size: 1.6rem; font-weight: 700; margin: 2.25rem 0 0.9rem; color: #111827; }
  .article-body h3 { font-family: 'Fraunces', Georgia, serif; font-size: 1.25rem; font-weight: 700; margin: 1.75rem 0 0.6rem; color: #111827; }
  .article-body a { color: #0e7490; text-decoration: none; }
  .article-body a:hover { text-decoration: underline; }
  .article-body ul, .article-body ol { margin: 0 0 1.25rem; padding-left: 1.3rem; }
  .article-body li { margin: 0.4rem 0; }
  .article-body strong { color: #111827; }
  .article-body blockquote { border-left: 3px solid #0e7490; margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1rem; color: #4b5563; font-style: italic; }
  .article-body hr { border: 0; border-top: 1px solid #e5e7eb; margin: 2rem 0; }
  .article-body table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.95rem; }
  .article-body th, .article-body td { border: 1px solid #e5e7eb; padding: 0.5rem 0.7rem; text-align: left; }
  .article-body th { background: #f0ede8; }
</style>
